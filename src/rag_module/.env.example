CHROMA_PATH=<absolute path to the chromadb folder inside this module>
CHROMA_TELEMETRY=False
GEMINI_API_KEY=<your Google Gemini API key>
GEMINI_MODEL=<Gemini model name, e.g. gemini-2.0-flash>
EMBEDDING_MODEL=BAAI/bge-m3
PDF_PARSER_URL=http://localhost:8001

# Docker volume mount paths (non-sensitive, used by docker-run.ps1)
HF_CACHE_PATH=<absolute path to your local HuggingFace hub cache>
CHROMADB_HOST_PATH=<absolute path to the chromadb folder inside this module>